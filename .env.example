#!/bin/bash
# Конфигурация резервного копирования.
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#   nano .env
# Файл читается как bash-скрипт, поэтому массивы и кавычки — обычный синтаксис bash.

# Имя сервера для сообщений об ошибках (пусто = hostname)
NAME=""

# ---------------------------------------------------------------------------
# Restic
# ---------------------------------------------------------------------------

# Адрес REST-репозитория.
# Формат: rest:http://ЛОГИН:ПАРОЛЬ@ХОСТ:8000/ПУТЬ/
# ЛОГИН:ПАРОЛЬ — это Basic Auth REST-сервера, а не пароль репозитория.
RESTIC_REPOSITORY="rest:http://LOGIN:PASSWORD@RESTIC_HOST:8000/PATH/"

# Пароль самого репозитория restic.
# Оставьте пустым, если репозиторий создан с флагом --insecure-no-password.
RESTIC_PASSWORD=""

# Что бэкапить и что исключать (пути через пробел)
BACKUP_PATH="/"
BACKUP_EXCLUDE="/proc /run /sys /dev /tmp /var/cache /var/tmp /swap.img /var/lib/lxcfs"

# Дополнительные аргументы restic backup (bash-массив)
RESTIC_ARGS=(
  "--pack-size" "128"
  "--tag=root"
  "--exclude-caches"
  "-x"
)

# Ограничения ресурсов (передаются в restic через окружение, см. backup.sh)
CPU_LIMIT="100%"
MEM_LIMIT="2G"

# Версия restic для установки. Пусто = последняя с GitHub.
RESTIC_VERSION=""

# ---------------------------------------------------------------------------
# Расписание и дополнительные задачи
# ---------------------------------------------------------------------------

# Расписание cron для main.sh
BACKUP_CRON="0 2 * * *"

# Проверка целостности репозитория перед бэкапом (yes/no)
RESTIC_CHECK="no"

# Бэкап GitLab своими средствами (yes/no)
GITLAB_BACKUP="no"
GITLAB_BACKUP_DIR="/bak/gitlab"

# ---------------------------------------------------------------------------
# Списки БД
# ---------------------------------------------------------------------------
# Каталог для дампов БД (по умолчанию /bak/db)
DB_DUMP_PATH="/bak/db"

# Каждая строка — одна база. Поля разделены символом |
# "all" в поле базы означает дамп всех баз.

# PostgreSQL: "база|пользователь"
POSTGRES_BACKUPS=(
  # "all|postgres"
  # "mydb|postgres"
)

# MySQL/MariaDB: "база|пользователь"
MYSQL_BACKUPS=(
  # "all|root"
  # "mydb|root"
)

# PostgreSQL в Docker: "база|пользователь|контейнер"
POSTGRES_DOCKER_BACKUPS=(
  # "all|postgres|postgres_container"
  # "mydb|postgres|postgres_container"
)

# MongoDB в Docker: "база|пользователь|пароль|контейнер"
MONGO_DOCKER_BACKUPS=(
  # "all|mongo_user|mongo_password|mongo_container"
  # "mydb|mongo_user|mongo_password|mongo_container"
)

# ---------------------------------------------------------------------------
# Уведомления об ошибках
# ---------------------------------------------------------------------------

# Telegram (пусто = не отправлять)
TG_TOKEN=""
TG_CHAT_ID=""

# Почта (пусто = не отправлять)
# SMTP_URL: smtp://host:587 — STARTTLS, smtps://host:465 — TLS сразу.
# Для Gmail/Яндекса и подобных используйте пароль приложения.
MAIL_FROM=""              # адрес отправителя
MAIL_RCPT=""              # получатели: через запятую или пробел
SMTP_USER=""              # логин SMTP; пусто = MAIL_FROM
MAIL_FROM_PASSWORD=""     # пароль или пароль приложения
# Механизм авторизации: пусто = авто, LOGIN = принудительно LOGIN
# (нужно, если сервер предлагает GSSAPI/NTLM и curl не может ими войти)
SMTP_AUTH="LOGIN"
SMTP_URL="smtp://smtp.example.com:587"
# yes — требовать STARTTLS для smtp://; no — для relay без TLS (обычно порт 25)
SMTP_STARTTLS="yes"
MAIL_SUBJECT_PREFIX="Restic backup"

# Прокси для Telegram, например http://proxy.example.com:8080 (пусто = без прокси)
PROXY=""
